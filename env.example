# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
RAW_TOPIC=raw-stream
PROCESSED_TOPIC=processed-stream
DLQ_TOPIC=dlq

# Dataset & producer
DATA_PATH=data/sample_dataset.jsonl
MIN_DELAY_SEC=0.05
MAX_DELAY_SEC=0.5

# Preprocessing / stream processor
MIN_TEXT_LEN=10
MAX_TOKEN_LEN=1024
BATCH_SIZE=32
BATCH_FLUSH_SEC=30
BATCH_DIR=data/batches

# Training
MODEL_NAME=meta-llama/Llama-3.2-3B
PROCESSED_BATCH_DIR=data/batches_processed
ADAPTER_DIR=checkpoints
MIN_BATCHES_TO_TRAIN=3
WATCH_INTERVAL_SEC=60
MAX_SEQ_LEN=1024

# Hugging Face Hub (opsional, untuk push checkpoint adapter)
HF_TOKEN=
HF_REPO_ID=
